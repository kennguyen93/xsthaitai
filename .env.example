# External Lottery API Base URL & Backend API Key (server-side only, strictly pha.vn)
PHA_API_BASE_URL="https://pha.vn/api/v1"
PHA_API_KEY=""

# Automatic Lottery Synchronization Scheduler & Google Cloud Scheduler Secret
AUTO_SYNC_ENABLED="true"
CRON_SYNC_SECRET=""

# Admin email restriction
ADMIN_EMAILS="kennguyen931908@gmail.com"

# Optional backend origin when frontend is hosted on a separate domain (defaults to same-origin /api)
VITE_API_BASE_URL=""
