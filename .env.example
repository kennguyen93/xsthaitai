# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL Runtime Credentials (auto-injected by AI Studio Cloud SQL)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional Redis Cache URL (falls back to server in-memory TTL cache if omitted)
REDIS_URL=""

# External Lottery API Base URL & Optional Backend API Keys (server-side only, never exposed to client)
XOSOVNM_BASE_URL="https://api.xosovnm.net/api"
XOSOVNM_API_KEY=""
LOTTERY_SECONDARY_API_KEY=""

# Automatic Lottery Synchronization Scheduler & Google Cloud Scheduler Secret
AUTO_SYNC_ENABLED="true"
CRON_SYNC_SECRET=""

# Optional comma-separated Admin emails (first signed-in user is also promoted if no admin exists)
ADMIN_EMAILS=""
